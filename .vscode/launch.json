{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/cmd/marchive",
      "cwd": "${workspaceFolder}",
      "buildFlags": "-trimpath",
      "env": {
        "CGO_ENABLED": "0"
      }
    },
    {
      "name": "Serve",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/cmd/marchive",
      "args": ["serve"],
      "cwd": "${workspaceFolder}",
      "buildFlags": "-trimpath",
      "env": {
        "CGO_ENABLED": "0"
      }
    },
    {
      "name": "Test",
      "type": "go",
      "request": "launch",
      "mode": "test",
      "program": "${workspaceFolder}",
      "cwd": "${workspaceFolder}",
      "buildFlags": "-trimpath",
      "env": {
        "CGO_ENABLED": "0"
      }
    }
  ]
}
